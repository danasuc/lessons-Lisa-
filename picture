        <h3>Task: Describe a memorable photo from your gallery</h3>
        <p>Pick any photo on your smartphone (a vacation, a family dinner, an accidental snapshot) and answer these prompts:</p>
        <ul style="margin-left: 20px; margin-top: 8px; color: var(--text-muted); font-size: 0.95rem;">
          <li>When and where was the photo taken?</li>
          <li>Who took the photo?</li>
          <li>What were you doing at that exact moment?</li>
          <li>What was the weather or atmosphere like?</li>
          <li>Why is this picture meaningful or funny to you?</li>
        </ul>
      </div>
    </section>

  </div>

  <script>
    function checkAnswers(containerId) {
      const container = document.getElementById(containerId);
      const items = container.querySelectorAll('.exercise-item');

      items.forEach(item => {
        const input = item.querySelector('input');
        const status = item.querySelector('.status-msg');
        const expected = input.getAttribute('data-ans').trim().toLowerCase();
        const actual = input.value.trim().toLowerCase();

        if (actual === expected) {
          status.textContent = "✓ Correct";
          status.className = "status-msg status-correct";
          input.style.borderColor = "var(--success)";
        } else {
          status.textContent = `✗ Expected: ${input.getAttribute('data-ans')}`;
          status.className = "status-msg status-wrong";
          input.style.borderColor = "var(--error)";
        }
      });
    }

    function resetAnswers(containerId) {
      const container = document.getElementById(containerId);
      const items = container.querySelectorAll('.exercise-item');

      items.forEach(item => {
        const input = item.querySelector('input');
        const status = item.querySelector('.status-msg');
        input.value = "";
        input.style.borderColor = "var(--border)";
        status.textContent = "";
        status.className = "status-msg";
      });
    }
  </script>

